# ===================================
# SCI Environment Variables
# ===================================
# Copy this file to .env and update the values for your environment

# ===================================
# GLOBAL APPLICATION SETTINGS
# ===================================
# Project-wide settings used by both frontend and backend
PROJECT_NAME=SCI
ENVIRONMENT=local

# Docker configuration
COMPOSE_PROJECT_NAME=sci
DOCKER_ENV=local


# ===================================
# BACKEND CONFIGURATION (FASTAPI)
# ===================================

# ===================================
# Backend Application Settings
# ===================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# API documentation settings
API_DOCS_ENABLED=true
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# CORS allowed origins (comma-separated)
# For development: include localhost and your machine IP
# For production: list your actual domain(s)
# Use wildcard (*) for IP ranges when testing on local network
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,<your-ip-address>:3000

# ===================================
# Backend Database Configuration
# ===================================
# Database configuration
# For Docker: use service name 'postgres' as host
# For local development: use 'localhost'
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=sci_db
POSTGRES_DB_TEST=sci_db_test
POSTGRES_SSLMODE=prefer
POSTGRES_ADMIN_DB=postgres

# Database connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ===================================
# Backend Auth / JWT Configuration
# ===================================
# Secrets and JWT settings
# Generate a secure secret: openssl rand -hex 32
SECRET_KEY=changethis
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===================================
# Initial Admin Bootstrap
# ===================================
# Provide these to create/remove an initial ADMIN user via the script (backend/scripts/manage_database.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator
ADMIN_PHONE_NUMBER=+14155550123
ADMIN_ORGANIZATION=SCI

# ===================================
# Backend Logging & Monitoring
# ===================================
# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log


# ===================================
# FRONTEND CONFIGURATION
# ===================================
# Frontend API URL - IMPORTANT NOTE:
# This is a BUILD-TIME variable for Next.js. For runtime URL detection,
# the application uses intelligent URL resolution based on the current host.
# Only set this if you need to override the automatic detection.
NEXT_PUBLIC_API_URL=http://localhost:8000


# ===================================
# SHARED CONFIGURATION
# ===================================
