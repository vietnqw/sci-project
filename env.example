# ===================================
# SCI Environment Variables
# ===================================
# Copy this file to .env and update the values for your environment

# ===================================
# GLOBAL APPLICATION SETTINGS
# ===================================
# Project-wide settings used by both frontend and backend
PROJECT_NAME=SCI
ENVIRONMENT=local


# ===================================
# BACKEND CONFIGURATION (FASTAPI)
# ===================================

# ===================================
# Backend Application Settings
# ===================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# API documentation settings
API_DOCS_ENABLED=true
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,<your-ip-address>:3000

# ===================================
# Backend Database Configuration
# ===================================
# Database configuration
# For local development: use 'localhost'
# For production: use your production database host, e.g., 'sci-postgres', 'prod-db.example.com', or your cloud database endpoint
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=sci_db
POSTGRES_SSLMODE=prefer
POSTGRES_ADMIN_DB=postgres

# Database connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ===================================
# Backend Auth / JWT Configuration
# ===================================
# Secrets and JWT settings
# Generate a secure secret: openssl rand -hex 32
SECRET_KEY=changethis
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===================================
# Initial Admin Bootstrap
# ===================================
# Provide these to create/remove an initial ADMIN user via the script (backend/scripts/manage_database.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=System Administrator
ADMIN_PHONE_NUMBER=+14155550123
ADMIN_ORGANIZATION=SCI

# ===================================
# Backend Logging & Monitoring
# ===================================
# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =============================================================================
# AWS S3 Configuration
# =============================================================================
AWS_ACCESS_KEY_ID=changethis
AWS_SECRET_ACCESS_KEY=changethis
AWS_REGION=us-east-1
S3_BUCKET_NAME=changethis

# =============================================================================
# CloudFront Configuration
# =============================================================================
# CloudFront distribution URL for caching S3 content
# Set this to your CloudFront distribution URL (e.g., https://d1234567890.cloudfront.net)
# Leave empty to use direct S3 URLs
CLOUDFRONT_BASE_URL=https://drhw6fozz9slr.cloudfront.net


# ===================================
# FRONTEND CONFIGURATION
# ===================================
# Frontend API URL
# NOTE: If you change the value below, make sure to rebuild the frontend Docker image so the new API URL is picked up!
NEXT_PUBLIC_API_URL=<your-ip-address>:8000


# ===================================
# SHARED CONFIGURATION
# ===================================
